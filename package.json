{
  "name": "party-map",
  "version": "2.0.0",
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "keycloak-js": "^26.2.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.49.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@rsbuild/core": "^2.2.11",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-typed-css-modules": "^1.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "0.5.4",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "sass-embedded": "^1.105.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "syncpack": "^15.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1",
  "private": true,
  "scripts": {
    "api:types": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "build": "rsbuild build",
    "check": "pnpm lint:deps && pnpm lint:code && pnpm lint:styles && pnpm lint:tsc && pnpm lint:classes && pnpm test:react --run --coverage && pnpm build",
    "clean": "rimraf dist .rsbuild coverage",
    "clean:all": "rimraf node_modules dist .rsbuild coverage",
    "commitlint": "commitlint",
    "dev": "rsbuild dev",
    "e2e": "playwright test",
    "e2e:update": "playwright test --grep @visual --update-snapshots",
    "e2e:visual": "playwright test --grep @visual",
    "lint:classes": "node scripts/unused-classes.mjs",
    "lint:code": "eslint",
    "lint:deps": "syncpack lint",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:tsc": "tsc --pretty --noEmit",
    "prepare": "husky",
    "preview": "rsbuild preview",
    "test:react": "vitest"
  },
  "type": "module"
}
