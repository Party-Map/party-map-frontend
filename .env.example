# Copy to .env.local for local development. All values are public (they ship in the bundle).
# The dev server proxies /api to the backend (API_URL, default http://localhost:8080), so PUBLIC_API_BASE stays unset.
# PUBLIC_API_BASE=/api
PUBLIC_KEYCLOAK_URL=http://localhost:8081
PUBLIC_KEYCLOAK_REALM=party-map
PUBLIC_KEYCLOAK_CLIENT_ID=partymap-web
